{
  "expo": {
    "name": "NCofres",
    "slug": "gdsn",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ncofres.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ncofres.app",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "react-native-quick-crypto",
      "expo-sharing",
      "expo-font",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Use o Face ID para desbloquear o cofre NCofres."
        }
      ]
    ],
    "backgroundColor": "#000000",
    "extra": {
      "eas": {
        "projectId": "40c9ee49-cc06-4ca7-9ec2-f02a8f3734d5"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/40c9ee49-cc06-4ca7-9ec2-f02a8f3734d5"
    }
  }
}
